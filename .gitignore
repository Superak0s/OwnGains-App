# Markdown is ignored by default so generated notes (audits, fix lists, plans)
# never get committed. A new doc that belongs in the repo needs a `!` line here.
*.md
!/README.md
!/CHANGELOG.md
!/CLAUDE.md
!/TODO.md
!/docs/**/*.md
!/.claude/**/*.md
!/.github/**/*.md
.mcp.json
.vale/
.vale.ini

# Local-only Play Console helper
scripts/play-recover.js
