{
  "name": "owngains-app",
  "description": "Offline-first fitness tracker: build splits, log workouts, track your body and supplements, and analyze progress with no account or server required.",
  "version": "1.0.1",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo prebuild --platform android --clean && expo run:android --app-id com.owngains.app.debug",
    "prebuild": "expo prebuild --platform android --clean",
    "build:android:apk": "npm run prebuild && local-expo-build build android --apk --no-sync --no-bump",
    "build:android:apk:clean": "npm run prebuild && local-expo-build build android --apk --no-sync --clean --no-bump",
    "build:android:apk:debug": "local-expo-build build android --apk --no-sync --no-bump --debug",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:a11y": "python3 scripts/find-unlabeled-icons.py",
    "test:coverage": "jest --coverage",
    "sonar:scan": "bash scripts/sonar-scan.sh",
    "build:icons": "python scripts/generate-icons.py",
    "build:privacy-policy": "node scripts/build-privacy-policy.js",
    "build:third-party-notices": "node scripts/build-third-party-notices.js",
    "build:android:aab": "node scripts/build.js aab",
    "check:all": "bash scripts/check-all.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.globalSetup.js",
    "testTimeout": 20000,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}",
      "!**/__tests__/**"
    ],
    "transform": {
      "\\.md$": "<rootDir>/jest.markdownTransform.js"
    },
    "moduleNameMapper": {
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^test-utils/(.*)$": "<rootDir>/src/test-utils/$1"
    }
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-firebase/analytics": "~27.1.0",
    "@react-native-firebase/app": "~27.1.0",
    "@react-native-firebase/perf": "~27.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~8.28.0",
    "base64-js": "^1.5.1",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-calendar": "~58.0.6",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-iap": "^5.8.3",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-health-connect": "^4.1.3",
    "react-native-pager-view": "9.0.7",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "react-native-zeroconf": "^0.17.6",
    "sp-react-native-in-app-updates": "^2.0.0",
    "tweetnacl": "^1.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "local-expo-build": "^1.1.3",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "unrs-resolver@1.12.2": true
  }
}
