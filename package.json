{
  "name": "owngains-app",
  "description": "Offline-first fitness tracker: build splits, log workouts, track your body and supplements, and analyze progress with no account or server required.",
  "version": "0.5.1",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo prebuild --platform android --clean && expo run:android --app-id com.owngains.app.debug",
    "prebuild": "expo prebuild --platform android --clean",
    "build:android:apk": "npm run prebuild && local-expo-build build android --apk --no-sync --no-bump",
    "build:android:apk:clean": "npm run prebuild && local-expo-build build android --apk --no-sync --clean --no-bump",
    "build:android:apk:debug": "local-expo-build build android --apk --no-sync --no-bump --debug",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:a11y": "python3 scripts/find-unlabeled-icons.py",
    "test:coverage": "jest --coverage",
    "sonar:scan": "bash scripts/sonar-scan.sh",
    "build:icons": "python scripts/generate-icons.py",
    "build:privacy-policy": "node scripts/build-privacy-policy.js",
    "build:third-party-notices": "node scripts/build-third-party-notices.js",
    "build:android:aab": "node scripts/build.js aab",
    "check:all": "bash scripts/check-all.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}",
      "!**/__tests__/**"
    ],
    "transform": {
      "\\.md$": "<rootDir>/jest.markdownTransform.js"
    },
    "moduleNameMapper": {
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^test-utils/(.*)$": "<rootDir>/src/test-utils/$1"
    }
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@sentry/react-native": "~7.11.0",
    "base64-js": "^1.5.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-iap": "^5.8.1",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-health-connect": "^4.1.3",
    "react-native-pager-view": "8.0.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.14.0",
    "sp-react-native-in-app-updates": "^2.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^57.0.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "local-expo-build": "^1.1.3",
    "react-refresh": "^0.18.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "unrs-resolver@1.12.2": true
  }
}
