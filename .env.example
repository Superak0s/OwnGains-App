# Copy to .env. Empty or commented out = off / default.
# Quote values with spaces: scripts/release.sh sources this file in bash.

## Built into the app (EXPO_PUBLIC_*, rebuild after changing)
# Crash reports. Empty = off.
EXPO_PUBLIC_SENTRY_DSN=
# true = dev/emulator builds also send (environment=development).
EXPO_PUBLIC_SENTRY_FORCE_ENABLE=
# Same value as the server's GOOGLE_WEB_CLIENT_ID. Empty hides Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

## Releasing (scripts/release.sh)
# Uploads sourcemaps. Without it, releases need --no-sourcemaps.
SENTRY_AUTH_TOKEN=
# Play upload: service-account JSON or path. Empty skips Play.
PLAY_SERVICE_ACCOUNT=
# internal | alpha | beta | production, comma-separated.
PLAY_TRACK=internal
# OTA target: user@host:/path/to/UPDATES_DIR
OTA_UPLOAD=
# OTA signing key. Default: secrets/expo-updates/private-key.pem
#EXPO_UPDATES_PRIVATE_KEY=
# EAS token for the versionCode sync. Default: your `eas login`.
#EXPO_TOKEN=

## Dev only
# SonarQube: scan token (npm run sonar:scan) and user token (scripts/sonarqube.py)
SONAR_TOKEN=
SONAR_USER_TOKEN=
