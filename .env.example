# Copy to .env and fill in real values. Expo inlines EXPO_PUBLIC_* vars at build time.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Set to true to let a dev/emulator build send to Sentry (environment=development).
EXPO_PUBLIC_SENTRY_FORCE_ENABLE=
# Web OAuth client ID from Google Cloud, the same value as GOOGLE_WEB_CLIENT_ID on the official server.
# Leave empty to hide the Google sign-in button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
